               <item row="4" column="1">
                <widget class="QLineEdit" name="txt_nJobs">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Number of bands dividing the frequency range and running simulateously. It has an impact on Rayleigh's damping approximation. The more the better.&lt;/p&gt;&lt;p&gt;Recommendation: the acoustic calculation is the most costly. If acoustic is ON, consider using as many jobs as possible and few CPUs. Otherwise, split adequately, eg. 6 jobs x 4 CPUs.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="text">
                  <string>24</string>
                 </property>
                </widget>
