               <item>
                <widget class="QCheckBox" name="cb_computeAcoustic">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If the acoustic mesh is 1D: the output is the acoustic pressure transfer function at each node of the mesh, if the mesh has no groups. If the mesh has groups, it is only calculated on the groups, which contain one node.&lt;/p&gt;&lt;p&gt;If the acoustic mesh is 2D: the ouput is the acoustic power transfer function, resulting from the intensity integrated over the mesh surface area.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="text">
                  <string>Compute acoustic</string>
                 </property>
                </widget>
               </item>
