                   <item>
                    <property name="text">
                     <string>Displacement</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                </layout>
               </item>
               <item>
                <widget class="QPushButton" name="btn_selectNodesFRF">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Groups with multiple nodes will generate one FRF, which is the average among the nodes. Groups, whose name finishes with 'Y' or 'Z', will generate the FRF in the vertical or lateral direction, respectively. Otherwise, the magnitude (lateral, vertical), is calculated.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="text">
                  <string>Select node groups for FRF...</string>
                 </property>
                </widget>
               </item>
