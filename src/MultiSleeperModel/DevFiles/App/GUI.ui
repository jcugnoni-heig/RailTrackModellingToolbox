               </item>
               <item row="5" column="1">
                <widget class="QLineEdit" name="txt_nCPUs">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Number of CPUs used per job (=frequency band).&lt;/p&gt;&lt;p&gt;Recommendation: the acoustic calculation is the most costly. If acoustic is ON, consider using as many jobs as possible and few CPUs. Otherwise, split adequately, eg. 6 jobs x 4 CPUs.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="text">
                  <string>1</string>
