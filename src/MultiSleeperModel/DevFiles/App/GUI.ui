                  <widget class="QLineEdit" name="txt_cumulMassEffeUn">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Minimum cumulated effective unit mass requested in each direction (see Code_Aster doc R5.01.03). It enables selecting the smallest number of eigenmodes such that the cumulated effective unit mass reaches that value (]0;1]) in each direction. With USP, 0.96 is advised for convergence.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="statusTip">
                    <string/>
