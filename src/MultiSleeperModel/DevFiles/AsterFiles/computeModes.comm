nuPadMat1 = parameters['nuMat1']
nuPadMat2 = parameters['nuMat2']
coefSlpBotArea = parameters['balAreaCoef']
nuBal = parameters['nuBal']
hBal = parameters['hBal']
ERail = parameters['ERail']
nuRail = parameters['nuRail']
rhoRail = parameters['rhoRail']
E1Sleeper = parameters['E1Sleeper']
E2Sleeper = parameters['E2Sleeper']
E3Sleeper = parameters['E3Sleeper']
nuSleeper = parameters['nuSleeper']
sleeperHeight = parameters['slpHeight']
rhoSleeper = parameters['rhoSleeper']
slpSpacing = parameters['slpSpacing']
clampStiffX = parameters['clampStiffX']*1000/2
clampStiffY = parameters['clampStiffY']*1000/2
clampStiffZ = parameters['clampStiffZ']*1000/2
try:
    railTilt = parameters['railTilt']
except:
    railTilt = 1/40.0

# List_phase1Freq = parameters['phase1Freq']
List_phase1Freq = parameters['phase1Freq'] if isinstance(parameters['phase1Freq'], list) else [parameters['phase1Freq']]
job_n = int(os.getenv("job_n", "default"))
print('Job number : ', job_n)
phase1Freq = List_phase1Freq[job_n-1]
# Rail dampers
try:
    dampers_on = parameters['dampers_on']
    if dampers_on:
        mtot = parameters["damper"].get("mtot")
        m1_ratio = parameters["damper"].get("m1_ratio")
        k1tot = parameters["damper"].get("k1tot")
        k2tot = parameters["damper"].get("k2tot")
        k3tot = parameters["damper"].get("k3tot")
        c1tot = parameters["damper"].get("c1tot")
        c2tot = parameters["damper"].get("c2tot")
        c3tot = parameters["damper"].get("c3tot")
except:
    print("Dampers properties not found, no damper applied for the simulation.")
    dampers_on = False

# Rail dampers macro-element 2
try:
    dampers_on2 = parameters["macroEl2"].get("dampers_on") if parameters["macroEl2"].get("dampers_on") is not None else dampers_on
    if dampers_on2:
        mtot_2 = parameters["macroEl2"]["damper"].get("mtot") if parameters["macroEl2"]["damper"].get("mtot") is not None else mtot
        m1_ratio_2 = parameters["macroEl2"]["damper"].get("m1_ratio") if parameters["macroEl2"]["damper"].get("m1_ratio") is not None else m1_ratio
        k1tot_2 = parameters["macroEl2"]["damper"].get("k1tot") if parameters["macroEl2"]["damper"].get("k1tot") is not None else k1tot
        k2tot_2 = parameters["macroEl2"]["damper"].get("k2tot") if parameters["macroEl2"]["damper"].get("k2tot") is not None else k2tot
        k3tot_2 = parameters["macroEl2"]["damper"].get("k3tot") if parameters["macroEl2"]["damper"].get("k3tot") is not None else k3tot
        c1tot_2 = parameters["macroEl2"]["damper"].get("c1tot") if parameters["macroEl2"]["damper"].get("c1tot") is not None else c1tot
        c2tot_2 = parameters["macroEl2"]["damper"].get("c2tot") if parameters["macroEl2"]["damper"].get("c2tot") is not None else c2tot
        c3tot_2 = parameters["macroEl2"]["damper"].get("c3tot") if parameters["macroEl2"]["damper"].get("c3tot") is not None else c3tot
        
except:
    print("Dampers properties not found for the second macro-element, no damper applied for the simulation.")
    dampers_on2 = False


if USP_on == True:
    nuUSP = parameters['nuUSP']
    thkUSP = parameters['thkUSP']

if USP2_on:
    thkUSP2 = parameters["macroEl2"].get("thkUSP") if ('macroEl2' in parameters.keys() and "thkUSP" in parameters['macroEl2'].keys() and parameters["macroEl2"].get("thkUSP") is not None) else parameters['thkUSP']
    nuUSP2 = parameters["macroEl2"].get("nuUSP") if parameters["macroEl2"].get("nuUSP") is not None else parameters['nuUSP']

# Create mesh only, or compute modes too
try:
    createMeshOnly = parameters['createMeshOnly']
except:
    createMeshOnly = False

# sleeper scaling (not implemented in GUI)
try:
    scaling_slpX = parameters['scaling_slpX']
    scaling_slpY = parameters['scaling_slpY']
except:
